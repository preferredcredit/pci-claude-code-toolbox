```
<workspace>\
  PlanningWorkspace\            # Shared read-only repos (always on main)
    <repo>\                      # One folder per registered repo (see PlanningWorkspace\repos.md)
  Active\
    <KEY>-###\                  # Ticketed work (Jira-keyed, e.g. CO-322, CRD-100)
      <KEY>-###.md              # Issue file (lean)
      spec.md                   # Full tier only — design from superpowers:brainstorming
      plan.md                   # Standard + Full tiers — from superpowers:writing-plans
      AgentWorkspace\           # Created only when Execute phase starts (shallow clone)
    <slug>\                     # Adhoc work (kebab-case slug)
      <slug>.md                 # Issue file, no Jira: line
      spec.md                   # Optional, Full tier only
      plan.md                   # Optional, Standard + Full tiers
      AgentWorkspace\           # Optional, if code was touched
  Complete\
    <KEY>-###\
      <KEY>-###.md              # Kept for reference
